# Salin file ini jadi ".env" lalu isi nilai aslinya. JANGAN commit file ".env"
# ke git (sudah masuk .gitignore).

# --- MongoDB (data user/akun login) ---
# Contoh lokal:  mongodb://localhost:27017
# Contoh Atlas:  mongodb+srv://user:password@cluster.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=sawala

# --- Akun admin awal ---
# Dibuat otomatis saat server pertama kali jalan, kalau belum ada user sama sekali.
# Ganti password ini setelah instalasi pertama.
ADMIN_EMAIL=admin@sawala.local
ADMIN_PASSWORD=change-me-strong-password

# --- JWT (sesi login) ---
# WAJIB diganti ke string acak panjang sebelum dipakai produksi.
# Contoh generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# --- SMTP (kirim email lupa password) ---
# Untuk Gmail: aktifkan 2FA lalu buat "App Password" di
# https://myaccount.google.com/apppasswords - itu yang diisi ke SMTP_APP_PASSWORD,
# BUKAN password akun Gmail biasa.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
SMTP_FROM_NAME=SAWALA

# --- Frontend URL (dipakai di link reset password dalam email) ---
PUBLIC_URL=http://localhost:5173
